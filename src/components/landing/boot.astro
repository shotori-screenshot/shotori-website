---
// Landing-page bootstrapper: fonts, the Tailwind-driven stylesheet, and the
// tiny copy-to-clipboard behaviour. Rendered once from each locale's index.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/landing.css';
---

<script is:inline>
	// Install-command copy. The landing page ships this one inline script on
	// purpose — everything else is either static or a hydrated demo island.
	document.addEventListener('click', async (e) => {
		const btn = e.target.closest('.landing .copy');
		if (!btn) return;
		const bar = btn.closest('.install-bar');
		const cmd = bar ? bar.querySelector('code').textContent : '';
		try {
			await navigator.clipboard.writeText(cmd);
		} catch {
			/* clipboard may be blocked; still confirm so it never feels dead */
		}
		const old = btn.getAttribute('data-label');
		btn.textContent = btn.getAttribute('data-done');
		setTimeout(() => {
			btn.textContent = old;
		}, 1500);
	});
</script>
